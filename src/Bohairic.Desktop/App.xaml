<Application x:Class="Bohairic.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Bohairic.Desktop">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <DataTemplate x:Key="DictionaryEntryTemplate">
        <StackPanel Padding="8,12" Spacing="5">
          <TextBlock Text="{Binding Word}" FontFamily="ms-appx:///Assets/FreeSerifAvvaShenouda.ttf#FreeSerifAvvaShenouda" FontSize="25" TextTrimming="CharacterEllipsis"/>
          <TextBlock local:CopticTypography.Text="{Binding Preview}" FontSize="14" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.6"/>
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
